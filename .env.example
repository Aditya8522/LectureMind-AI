# ── LectureMind AI Environment Configuration ──────────────────────────────────
# 1. Primary Google Gemini API Key (Required for Smart Notes & Embeddings)
# Get your key at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# 2. Secondary Gemini API Key (Optional — used as fallback or dedicated chat key)
GEMINI_API_KEY_2=your_secondary_gemini_api_key_here

# 3. Secret key for HMAC token signing (Optional — defaults to internal secret if empty)
AUTH_SECRET_KEY=your_random_secret_key_for_jwt_session_signing
